# 复制成 .env 后填入真实值。.env 已被 .gitignore 忽略，永远不要提交。
# 这个模板存在的意义就是：不需要为了"让项目跑起来"而把真 .env 提上去。

# ── Azure OpenAI（必填，AI 节点全部走这里）──────────────────────────────
# endpoint 用经典基地址 https://<资源名>.openai.azure.com/ ，SDK 会自己拼
# /openai/deployments/<deployment>/chat/completions?api-version=...
# 不要填 Foundry 门户里的 .../openai/v1/responses —— 那是完整 URL，不是基地址。
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
# 仅接受 2024-12-01-preview ~ 2025-04-01-preview 之间的日期版本
AZURE_OPENAI_API_VERSION=

# ── 网络代理（中国大陆访问 Google 必填）──────────────────────────────
# 常见端口：Yep! 7892，Clash 7890，V2Ray 10809。端口填错会导致
# Google Ads 关键词规划师全部失败，扩展结果会退化成只剩本地化的
# Bing/Google Suggest 词（如 "xxx near me"）。
HTTP_PROXY=

# ── WordPress ──────────────────────────────────────────────────────
WORDPRESS_URL=
WORDPRESS_USERNAME=
WORDPRESS_PASSWORD=
# 应用密码（后台「用户 → 应用程序密码」生成），发布走这个而不是登录密码
WORDPRESS_APPLICATION_PASSWORD=
SCHEDULE_POSTS=
DEFAULT_SCHEDULE_HOURS=
DEFAULT_SCHEDULE_INTERVAL_HOURS=
WORDPRESS_TIMEZONE=

# ── Google Ads Keyword Planner（可选，但缺了会显著影响关键词质量）─────
# refresh token 可用 scripts/generate_google_ads_refresh_token.py 生成
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
